# ==============================================================================
# Fast Foodiy — Backend environment variables (root .env)
# ==============================================================================
# This is the CANONICAL example. Copy to `.env` at the repo root for the
# backend (Express + tsx) and place the FRONTEND block (see below) into
# `frontend/.env` because Vite only loads env vars from its own directory.
#
# Vars consumed by src/infrastructure/config/env.ts.

# Backend runtime configuration
PERSISTENCE_DRIVER=postgres #memory | postgres | upstash
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fast_foodiy
PORT=3000

# --- Upstash Redis (only for PERSISTENCE_DRIVER=upstash) ----------------
# Create a DB in https://upstash.com and copy the REST URL + token.
# Keys are namespaced (fast-foodiy:{entidad}:{id}) so the DB can be shared.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (sessions) ------------------------------------------------------
# Secret used to sign the httpOnly session cookie (JWT HS256). Use a strong,
# random value in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-in-production

# Session TTL in seconds (default 604800 = 7 days).
SESSION_TTL=604800

# Demo mode (enables seeding demo auth users: admin/admin123, staff/staff123,
# customer Maria +57/customer123). `true` to enable.
DEMO_MODE=false

# Set to `production` in production. Controls Secure cookie flag.
NODE_ENV=development

# ==============================================================================
# Fast Foodiy Frontend environment variables (frontend/.env)
# ==============================================================================
# Vite reads these from `frontend/.env` (NOT the repo root). Only variables
# prefixed with `VITE_` are exposed to the client via `import.meta.env`.
# Consumed by frontend/src/api/config.ts.

# API base URL. Defaults to `/api/v1`, which the Vite dev server proxies to
# the backend (see frontend/vite.config.ts). In production set this to your
# API origin, e.g. https://api.fast-foodiy.com
VITE_API_URL=/api/v1

# Demo mode — enables autologin buttons on the Login page for quick testing.
# Set to `true` to enable (must match backend DEMO_MODE=true to have users).
VITE_DEMO_MODE=false