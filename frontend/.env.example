# Fast Foodiy Frontend Environment Variables
#
# The CANONICAL documentation for all env vars (backend + frontend) lives in
# ../.env.example at the repo root. Copy that FRONTEND block here.
#
# Vite loads these from THIS directory (frontend/.env) only, and exposes only
# variables prefixed with `VITE_` to `import.meta.env`.
# Consumed by ../src/api/config.ts.

# API base URL. Defaults to /api/v1 (proxied by the Vite dev server to
# localhost:3000). In production set this to your API origin,
# e.g. https://api.fast-foodiy.com
VITE_API_URL=/api/v1

# Demo mode — enables autologin buttons on the Login page for quick testing.
# Set to 'true' to enable (must match backend DEMO_MODE=true to have users).
VITE_DEMO_MODE=true