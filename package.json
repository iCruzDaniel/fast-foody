{
  "name": "fast-foodiy",
  "version": "1.0.0",
  "description": "REST API for restaurant order management",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "build:vercel": "esbuild src/vercel-entry.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs --alias:@domain=./src/domain --alias:@shared=./src/shared --alias:@application=./src/application --external:@prisma/client && node scripts/create-vercel-output.js",
    "start": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs --alias:@domain=./src/domain --alias:@shared=./src/shared --alias:@application=./src/application --external:@prisma/client && node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts",
    "teardown": "tsx src/teardown.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@upstash/redis": "^1.38.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.1.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
