{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "builds": [
    {
      "src": "dist/index.cjs",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/index.cjs"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "dist/index.cjs" }
  ]
}